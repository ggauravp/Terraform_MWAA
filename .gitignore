# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config files
.terraformrc
terraform.rc

# Plan output
*.tfplan

# Dependency lock info (optional, uncomment if you DON'T want to track it)
.terraform.lock.hcl
